        googletag.pubads().setTargeting("pageTag", []);
        googletag.pubads().setTargeting("environment", ["production"]);
        googletag.pubads().setTargeting("adopstest", (window.location.search.match(/adopstest=(\w+)/) || [, ''])[1]);

        
        // Performance optimizations for better ad viewability
        googletag.pubads().disableInitialLoad();
        googletag.pubads().enableSingleRequest();
        googletag.pubads().collapseEmptyDivs();

        // Check for debug URL parameters
        var debugParams = ['ad_debug', 'debug_ads', 'ads_debug'];
        var debugEnabled = false;

        for (var i = 0; i < debugParams.length; i++) {
            var urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get(debugParams[i]) === '1') {
                debugEnabled = true;
                break;
            }
        }

        // Debug logging function
        function advertDebugLog(message, data) {
            if (debugEnabled) {
                console.log(message, data);
            }
        }

       // Add viewability tracking
       googletag.pubads().addEventListener('slotVisibilityChanged', function(event) {
           if (event.inViewPercentage >= 50) {
               // Debug log for viewability
               advertDebugLog('[AD VIEWABLE (Main)]:', {
                   slotId: event.slot.getSlotElementId(),
                   viewabilityPercentage: event.inViewPercentage + '%',
                   timestamp: new Date().toISOString(),
                   pageUrl: window.location.href,
                   adSize: event.slot.getSizes(),
                   isEmpty: event.isEmpty
               });


               if (typeof window.dataLayer !== "undefined") {
                   window.dataLayer.push({
                       event: 'ad_viewability',
                       ad_slot: event.slot.getSlotElementId(),
                       viewability_percentage: event.inViewPercentage,
                       page_url: window.location.href
                   });
               }
           } else {
               // Debug log for non-viewable ads
               advertDebugLog('[AD NOT VIEWABLE (Main)]:', {
                   slotId: event.slot.getSlotElementId(),
                   viewabilityPercentage: event.inViewPercentage + '%',
                   timestamp: new Date().toISOString(),
                   pageUrl: window.location.href
               });
           }
       });

        // Add ad load tracking
        googletag.pubads().addEventListener('slotRenderEnded', function(event) {
            const slotId = event.slot.getSlotElementId();
            const loadTime = performance.now() - (window.adLoadStartTime || performance.now());

            advertDebugLog('[AD LOADED (Main)]:', {
                slotId: slotId,
                isEmpty: event.isEmpty,
                loadTime: Math.round(loadTime) + 'ms',
                timestamp: new Date().toISOString(),
                pageUrl: window.location.href,
                adSize: event.slot.getSizes()
            });
        });

        // Track when ads start loading
        googletag.pubads().addEventListener('slotRequested', function(event) {
            const slotId = event.slot.getSlotElementId();

            advertDebugLog('[AD REQUESTED (Main)]:', {
                slotId: slotId,
                timestamp: new Date().toISOString(),
                pageUrl: window.location.href,
                adSize: event.slot.getSizes()
            });

            // Set start time for load tracking
            if (!window.adLoadStartTime) {
                window.adLoadStartTime = performance.now();
            }
        });

        // Debug mode indicator
        if (debugEnabled) {
            console.log('[AD DEBUG MODE ENABLED (Main)] - Console logging active');
            console.log('Debug URL parameters: ?ad_debug=1, ?debug_ads=1, ?ads_debug=1');
        }

        // Debug log when GPT is ready
        advertDebugLog('[GPT INITIALIZED]:', {
            timestamp: new Date().toISOString(),
            pageUrl: window.location.href,
            viewportWidth: window.innerWidth,
            viewportHeight: window.innerHeight,
            debugMode: debugEnabled
        });

        googletag.enableServices();

    });
</script>

